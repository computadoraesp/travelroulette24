# R8 Keep Rules for TravelRoulette24

# Keep kotlinx.serialization classes & annotations
-keepattributes *Annotation*,ElementValueAttribute,Signature
-keepclassmembers class * {
    *** Companion;
}
-keepclasseswithmembers class * {
    public static *** Companion;
}
-keepclassmembers class * {
    @kotlinx.serialization.SerialName <fields>;
}
-keep,allowobfuscation,allowshrinking @kotlinx.serialization.Serializable class * { *; }
-keepclassmembers class * {
    @kotlinx.serialization.Serializable *;
}

# Keep TravelRoulette data models and engine serializers
-keep class com.example.travelroulette24.engine.TravelIntelligenceEngine$** { *; }
-keep class com.example.travelroulette24.budget.BudgetGuardian$** { *; }
-keep class com.example.travelroulette24.data.BackendApi$** { *; }
-keep class com.example.travelroulette24.data.byok.CustomTravelProvider { *; }

# Retrofit & OkHttp
-keepattributes Signature, InnerClasses, EnclosingMethod
-keepattributes RuntimeVisibleAnnotations, RuntimeVisibleParameterAnnotations
-keepclassmembers enum * { *; }
-keep interface com.example.travelroulette24.data.BackendApi { *; }

# ZXing QR Code
-keep class com.google.zxing.qrcode.** { *; }

# Hilt Dependency Injection
-keep class dagger.hilt.** { *; }
-keep class com.example.travelroulette24.di.** { *; }
